<configuration>
    <!--
      Redaction policy (TRD 5.4, PC-10): request text is never logged, and %nopex drops every
      exception (stack and message) so an exception that quotes input cannot reach the log.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601,UTC} %-5level %logger{24} %msg%n%nopex</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
    <logger name="com.google" level="WARN"/>
    <logger name="com.nimbusds" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
